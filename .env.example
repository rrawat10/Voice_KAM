# Keep this file's example values; put real credentials in .env (ignored by Git).
GEMINI_API_KEY=
LIVE_MODEL=gemini-3.8-live
PLANNER_MODEL=gemini-3.5-flash-lite
PLANNER_THINKING_LEVEL=minimal
# Sessions are temporary in-process memory; run one server worker.
SESSION_TTL_SECONDS=1800
MAX_CALL_SECONDS=300
MAX_CONCURRENT_CALLS=2
PLANNER_TIMEOUT_SECONDS=8
SECURE_COOKIES=false
